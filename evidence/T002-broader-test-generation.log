from modules.kicad_sch_interface import *

# Define center position for the main component (resistor)
center_x_1, center_y_1 = 150.0, 150.0

# Place the current‑limiting resistor (R1)
add_schematic_symbol(
    symbol_lib="Device",
    symbol_name="R",
    pos_x=center_x_1,
    pos_y=center_y_1,
    reference="R1",
    value="1k",
    rotation=0,
    mirror="None"
)

# Place the LED (D1) below the resistor
add_schematic_symbol(
    symbol_lib="Device",
    symbol_name="LED",
    pos_x=center_x_1,
    pos_y=center_y_1 - 20.0,
    reference="D1",
    value="LED",
    rotation=0,
    mirror="None"
)

# Place the +5V power symbol above the resistor
add_schematic_symbol(
    symbol_lib="power",
    symbol_name="+5V",
    pos_x=center_x_1,
    pos_y=center_y_1 + 20.0,
    reference="#PWR1",
    value="+5V",
    rotation=0,
    mirror="None"
)

# Place the GND power symbol below the LED
add_schematic_symbol(
    symbol_lib="power",
    symbol_name="GND",
    pos_x=center_x_1,
    pos_y=center_y_1 - 40.0,
    reference="#PWR2",
    value="GND",
    rotation=0,
    mirror="None"
)

# Connect +5V to the resistor (pin 1)
connect_pins("#PWR1", "1", "R1", "1")

# Connect resistor to LED anode (pin A)
connect_pins("R1", "2", "D1", "A")

# Connect LED cathode (pin K) to GND
connect_pins("D1", "K", "#PWR2", "1")

# Write out all wires
write_out_all_wires()


