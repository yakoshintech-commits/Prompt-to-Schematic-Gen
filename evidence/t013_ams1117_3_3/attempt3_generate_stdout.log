import sys
import os

# Get project path and import kicad schematic interface
PROJECT_PATH = os.environ['PROJECT_PATH']
sys.path.append(PROJECT_PATH)
from modules.kicad_sch_interface import *

### Placing center symbol 1 : Regulator_Linear:AMS1117-3.3###

center_x_1, center_y_1 = 150.0, 110.0

add_schematic_symbol(symbol_lib="Regulator_Linear",
                     symbol_name="AMS1117-3.3",
                     pos_x=center_x_1,
                     pos_y=center_y_1,
                     reference="U1",
                     value="AMS1117-3.3",
                     rotation=0,
                     mirror="None")

### Placing other symbols in the Schematic with respect to the center symbol 1###

# Add global label VIN
add_label(label_pos=[center_x_1 + (-10), center_y_1 + (8)],
          label_text="VIN",
          label_ref="VIN_0",
          label_type="input",
          text_orient="left")

# Add global label VOUT
add_label(label_pos=[center_x_1 + (11), center_y_1 + (8)],
          label_text="VOUT",
          label_ref="VOUT_0",
          label_type="output",
          text_orient="right")

# Place a resistor R1 2.2k between VIN and the regulator input pin
add_schematic_symbol(symbol_lib="Device",
                     symbol_name="R",
                     pos_x=center_x_1 + (-10),
                     pos_y=center_y_1 + (0),
                     reference="R1",
                     value="2.2K",
                     rotation=0,
                     mirror="None")

# Place a capacitor C1 1µF on the regulator output
add_schematic_symbol(symbol_lib="Device",
                     symbol_name="C",
                     pos_x=center_x_1 + (11),
                     pos_y=center_y_1 + (0),
                     reference="C1",
                     value="1uF",
                     rotation=0,
                     mirror="None")

# Place a GND symbol
add_schematic_symbol(symbol_lib="power",
                     symbol_name="GND",
                     pos_x=center_x_1,
                     pos_y=center_y_1 + (-12),
                     reference="#PWR1",
                     value="GND",
                     rotation=0,
                     mirror="None")

### Connecting all wires in the Schematic ###

# Connect U1 pin VOUT (Pin ID 1) to C1 pin 1
connect_pins("U1", "VOUT", "C1", "1")

# Connect C1 pin 2 to GND
connect_pins("C1", "2", "#PWR1", "1")

# Connect R1 pin 2 to U1 pin VIN (Pin ID 2)
connect_pins("R1", "2", "U1", "VIN")

# Connect VIN label to R1 pin 1
connect_pins("VIN_0", "1", "R1", "1")

# Connect VOUT label to U1 pin VOUT (Pin ID 1)
connect_pins("VOUT_0", "1", "U1", "VOUT")

# Write out all wires
write_out_all_wires()
