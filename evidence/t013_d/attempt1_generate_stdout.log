import sys
import os

# Get project path and import kicad schematic interface
PROJECT_PATH = os.environ['PROJECT_PATH']
sys.path.append(PROJECT_PATH)
from modules.kicad_sch_interface import *

### Placing center symbol 1 : Device:D###

center_x_1, center_y_1 = 150.0, 110.0

add_schematic_symbol(symbol_lib="Device", symbol_name="D", pos_x=center_x_1, pos_y=center_y_1, reference="D1", value="D", rotation=180, mirror="None")

### Placing other symbols in the Schematic with respect to the center symbol 1###

add_schematic_symbol(symbol_lib="power", symbol_name="+5V", pos_x=center_x_1 + (-30), pos_y=center_y_1 + (15), reference="#PWR1", value="+5V", rotation=0, mirror="None")
add_schematic_symbol(symbol_lib="Device", symbol_name="R", pos_x=center_x_1 + (-30), pos_y=center_y_1 + (10), reference="R1", value="1k", rotation=0, mirror="None")
add_schematic_symbol(symbol_lib="power", symbol_name="GND", pos_x=center_x_1 + (0), pos_y=center_y_1 + (-10), reference="#PWR2", value="GND", rotation=0, mirror="None")

### Placing all global labels in the Schematic and connect them to the neighbor pin ###

# Add label DOUT next to D1 pin A 
x_D1_1, y_D1_1 = get_pin_location(symbol_ref="D1", pin_name="A")
add_label(label_pos=[x_D1_1+(-6), y_D1_1+(0)], label_text="DOUT", label_ref="DOUT_0", label_type="input", text_orient="left")
# Connecting Label DOUT label_id:0 to D1 pin A (Pin ID 1 -- Name A)
connect_pins("DOUT_0", "1", "D1", "A")

# Add label DIN next to R1 pin 2 
x_R1_2, y_R1_2 = get_pin_location(symbol_ref="R1", pin_name="2")
add_label(label_pos=[x_R1_2+(-6), y_R1_2+(0)], label_text="DIN", label_ref="DIN_0", label_type="input", text_orient="left")
# Connecting Label DIN label_id:0 to R1 pin 2 (Pin ID 2 -- Name 2)
connect_pins("DIN_0", "1", "R1", "2")


### Connecting all wires in the Schematic ###


# Connecting #PWR1 pin +5V (Pin ID 1 -- Name +5V) to R1 pin 1 (Pin ID 1 -- Name None)
connect_pins("#PWR1", "+5V", "R1", "1")

# Connecting R1 pin 2 (Pin ID 2 -- Name None) to D1 pin A (Pin ID 1 -- Name A)
connect_pins("R1", "2", "D1", "A")

# Connecting D1 pin K (Pin ID 2 -- Name K) to #PWR2 pin 1 (Pin ID 1 -- Name None)
connect_pins("D1", "K", "#PWR2", "1")

write_out_all_wires()
