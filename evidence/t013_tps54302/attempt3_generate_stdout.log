# Connecting R2 pin ~ (Pin ID 2 -- Name ~) to U1 pin VIN (Pin ID 3 -- Name VIN)
connect_pins("R2", "~", "U1", "VIN")

# Connecting U1 pin GND (Pin ID 1 -- Name GND) to R1 pin ~ (Pin ID 1 -- Name ~)
connect_pins("U1", "GND", "R1", "~")

write_out_all_wires()
