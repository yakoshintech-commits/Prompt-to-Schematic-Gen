sys.path.append(PROJECT_PATH)
from modules.kicad_sch_interface import *

### Placing center symbol 1 : Regulator_Switching:TPS54302###

center_x_1, center_y_1 = 150.0, 110.0

add_schematic_symbol(symbol_lib="Regulator_Switching", symbol_name="TPS54302", pos_x=center_x_1, pos_y=center_y_1, reference="U1", value="TPS54302", rotation=270, mirror="None")

### Placing other symbols in the Schematic with respect to the center symbol 1###

add_schematic_symbol(symbol_lib="74xx_IEEE", symbol_name="R", pos_x=center_x_1 + (-25), pos_y=center_y_1 + (0), reference="R1", value="2.2K", rotation=0, mirror="None")
add_schematic_symbol(symbol_lib="74xx_IEEE", symbol_name="R", pos_x=center_x_1 + (-15), pos_y=center_y_1 + (0), reference="R2", value="2.2K", rotation=0, mirror="None")

### Connecting all wires in the Schematic ###


# Connecting U1 pin VIN (Pin ID 3 -- Name VIN) to R1 pin ~ (Pin ID 2 -- Name ~)
connect_pins("U1", "VIN", "R1", "~")

# Connecting R1 pin ~ (Pin ID 1 -- Name ~) to R2 pin ~ (Pin ID 1 -- Name ~)
