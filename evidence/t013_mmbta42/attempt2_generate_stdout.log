import sys
import os

# Get project path and import kicad schematic interface
PROJECT_PATH = os.environ['PROJECT_PATH']
sys.path.append(PROJECT_PATH)
from modules.kicad_sch_interface import *

### Placing center symbol 1 : Transistor_BJT:MMBTA42###

center_x_1, center_y_1 = 150.0, 110.0

add_schematic_symbol(symbol_lib="Transistor_BJT", symbol_name="MMBTA42", pos_x=center_x_1, pos_y=center_y_1, reference="Q1", value="MMBTA42", rotation=180, mirror="None")

### Placing other symbols in the Schematic with respect to the center symbol 1###

# Power source (+V) positioned above the transistor
add_schematic_symbol(symbol_lib="power", symbol_name="+V", pos_x=center_x_1 + (-22), pos_y=center_y_1 + (10), reference="#PWR1", value="+V", rotation=0, mirror="None")

# Pull‑up resistor for the emitter (10 kΩ)
add_schematic_symbol(symbol_lib="Device", symbol_name="R", pos_x=center_x_1 + (-22), pos_y=center_y_1 + (0), reference="R1", value="10k", rotation=0, mirror="None")

# Ground symbol below the transistor
add_schematic_symbol(symbol_lib="power", symbol_name="GND", pos_x=center_x_1 + (-22), pos_y=center_y_1 + (-13), reference="#PWR2", value="GND", rotation=0, mirror="None")

# Base bias resistor (1 kΩ)
add_schematic_symbol(symbol_lib="Device", symbol_name="R", pos_x=center_x_1 + (-8), pos_y=center_y_1 + (0), reference="R2", value="1k", rotation=0, mirror="None")

# Ground for the bias network
add_schematic_symbol(symbol_lib="power", symbol_name="GND", pos_x=center_x_1 + (-8), pos_y=center_y_1 + (-12), reference="#PWR3", value="GND", rotation=0, mirror="None")

# Collector resistor (2 kΩ)
add_schematic_symbol(symbol_lib="Device", symbol_name="R", pos_x=center_x_1 + (7), pos_y=center_y_1 + (2), reference="R3", value="2k", rotation=0, mirror="None")

# Ground for the collector network
add_schematic_symbol(symbol_lib="power", symbol_name="GND", pos_x=center_x_1 + (7), pos_y=center_y_1 + (-7), reference="#PWR4", value="GND", rotation=0, mirror="None")

### Placing all global labels in the Schematic and connect them to the neighbor pin ###


### Connecting all wires in the Schematic ###


# Connecting R1 pin 2 to Q1 pin B (Base)
connect_pins("R1", "2", "Q1", "B")

# Connecting #PWR1 pin +V to R1 pin 1
connect_pins("#PWR1", "+V", "R1", "1")

# Connecting R2 pin 2 to Q1 pin E (Emitter)
connect_pins("R2", "2", "Q1", "E")

# Connecting Q1 pin C (Collector) to R3 pin 1
connect_pins("Q1", "C", "R3", "1")

# Connecting R2 pin 1 to #PWR3 pin 1 (Ground for bias network)
connect_pins("R2", "1", "#PWR3", "1")

# Connecting R3 pin 2 to #PWR4 pin 1 (Ground for collector network)
connect_pins("R3", "2", "#PWR4", "1")

